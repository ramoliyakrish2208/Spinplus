# Spin & Win SaaS Environment Configuration Template
# Copy this file to .env on the production server and populate with real, secure values.

# Core Security & Debugging
SECRET_KEY=change-me-to-a-very-long-random-string-in-production
DJANGO_DEBUG=False
SITE_URL=https://yourdomain.com

# Networking & Host Resolution
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# HTTPS / SSL Hardening (Keep True behind Nginx SSL in Production)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
X_FRAME_OPTIONS=DENY
